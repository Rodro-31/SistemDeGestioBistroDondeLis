# Copia este archivo a .env y ajusta los valores antes de levantar el
# proyecto con: docker compose up -d

# Postgres
DB_USER=cambia_esto_por_tu_usuario
DB_PASSWORD=cambia_esto_por_una_contraseña_segura

# n8n: no son variables de entorno que lea docker-compose.yml quedan aquí solo como referencia de
# qué credenciales usar al crear tu propia cuenta de administrador la primera
# vez que entres a http://localhost:5678
N8N_USER=cambia_esto_por_tu_usuario
N8N_PASSWORD=cambia_esto_por_una_contraseña_segura
